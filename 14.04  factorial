#include <iostream>
using namespace std;

int findFactorial(long long n, long long current = 1, int i = 1) {
    if (current == n) return i;
    if (current > n) return -1;

    return findFactorial(n, current * (i + 1), i + 1);
}

int main() {
    cout << findFactorial(120) << endl; 
    cout << findFactorial(5040) << endl;
}
