#include <iostream>
#include <algorithm>
using namespace std;

string add(string a, string b) {
    string result = "";
    int carry = 0;

    int i = a.size() - 1;
    int j = b.size() - 1;

    while (i >= 0 || j >= 0 || carry) {
        int sum = carry;

        if (i >= 0) sum += a[i--] - '0';
        if (j >= 0) sum += b[j--] - '0';

        result += (sum % 10) + '0';
        carry = sum / 10;
    }

    reverse(result.begin(), result.end());
    return result;
}

int main() {
    cout << add("123", "89") << endl; 
    cout << add("99", "1") << endl;   
    cout << add("999", "1") << endl;  
}
