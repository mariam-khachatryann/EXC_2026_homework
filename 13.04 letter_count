#include <iostream>
#include <string>
using namespace std;

string encodeRLE(string s) {
    string result = "";
    int n = s.size();

    for (int i = 0; i < n; i++) {
        int count = 1;

        while (i + 1 < n && s[i] == s[i + 1]) {
            count++;
            i++;
        }

        if (count >= 2) {
            result += to_string(count);
        }

        result += s[i];
    }

    return result;
}

int main() {
    string s;
    cout << "Enter string: ";
    cin >> s;

    cout << "Encoded: " << encodeRLE(s) << endl;

    return 0;
}
