#include <iostream>
using namespace std;

int main() {
    int intervals[][2] = {{1,3},{6,9}};
    int n = 2;

    int newStart = 2;
    int newEnd = 5;

    int res[100][2];
    int k = 0;

    for (int i = 0; i < n; i++) {

        if (intervals[i][1] < newStart) {
            res[k][0] = intervals[i][0];
            res[k][1] = intervals[i][1];
            k++;
        }

        else if (intervals[i][0] > newEnd) {
            res[k][0] = newStart;
            res[k][1] = newEnd;
            k++;

            for (int j = i; j < n; j++) {
                res[k][0] = intervals[j][0];
                res[k][1] = intervals[j][1];
                k++;
            }

            break;
        }
        
        else {
            if (intervals[i][0] < newStart)
                newStart = intervals[i][0];

            if (intervals[i][1] > newEnd)
                newEnd = intervals[i][1];
        }
    }

    if (k == 0 || res[k-1][1] < newStart) {
        res[k][0] = newStart;
        res[k][1] = newEnd;
        k++;
    }

    for (int i = 0; i < k; i++) {
        cout << "[" << res[i][0] << "," << res[i][1] << "] ";
    }
}
